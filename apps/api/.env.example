# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

PSQL_PORT="5432"
PSQL_HOST="localhost"
PSQL_DATABASE_NAME="gestao-equipes"
PSQL_USERNAME="your_username"
PSQL_PASSWORD="your_password"

DATABASE_URL="postgresql://your_username:your_password@localhost:5432/gestao-equipes"
